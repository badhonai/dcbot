DISCORD_TOKEN=
# Optional: only used for PUBLIC mention/reply AI chat
GROQ_API_KEY=
# Only needed for npm run deploy:commands
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Console logging: debug | info | warn | error | silent
LOG_LEVEL=info
# compact (mobile-friendly) | wide (desktop) | json (log collectors)
LOG_FORMAT=compact
# Maximum line width for compact logs (32-120)
LOG_WIDTH=48
