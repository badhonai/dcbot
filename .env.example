# Optional free CoinGecko Demo key; keyless access may be rate limited.
COINGECKO_DEMO_API_KEY=
DISCORD_TOKEN=
# Primary AI agent + official web search (free-account quotas apply).
# Add the real key only on your host. Groq fallback does not restore search allowance.
OLLAMA_API_KEY=
# Optional fallback when Ollama credits/quota are exhausted or unavailable.
GROQ_API_KEY=
# Optional model overrides; defaults are set in config.json.
OLLAMA_MODEL=
GROQ_MODEL=
# Optional overrides for npm run deploy:commands only.
# Startup automatically syncs commands to ALL joined servers.
# Without IDs, the deployment script also discovers all joined servers.
DISCORD_APPLICATION_ID=
# Comma-separated server IDs; leave blank for all.
DISCORD_GUILD_IDS=
# Legacy single-server fallback (ignored when DISCORD_GUILD_IDS is set).
DISCORD_GUILD_ID=

# Console logging: debug | info | warn | error | silent
LOG_LEVEL=info
# compact (mobile-friendly) | wide (desktop) | json (log collectors)
LOG_FORMAT=compact
# Maximum line width for compact logs (32-120)
LOG_WIDTH=48

# Sanitized HTTP health routes on your hosting allocation (no secrets/API proxy).
HEALTH_ENABLED=true
# Override if PORT / SERVER_PORT does not match your allocated port:
# HEALTH_PORT=25031
# One small AI check at startup; false skips it. No AI calls per HTTP visit.
HEALTH_CHECK_AI=true
# 0 = startup-only price probe (conserves quota); optional 10–1440 minutes.
HEALTH_PROBE_INTERVAL_MINUTES=0
# Existing CG_API_KEY or COINGECKO_API_KEY are also accepted as Demo key aliases.
# Use one name; COINGECKO_DEMO_API_KEY takes precedence. No Pro inference.
