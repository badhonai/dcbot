{
  "name": "discord-ai-bot",
  "version": "1.1.0",
  "description": "Lightweight read-only Discord community agent with crypto research and games",
  "main": "src/index.js",
  "scripts": {
    "start": "node --max-old-space-size=128 src/index.js",
    "test": "node --test",
    "diagnose": "node scripts/diagnose.js",
    "deploy:commands": "node scripts/deploy-commands.js",
    "check:budget": "node --expose-gc --max-old-space-size=128 scripts/community-budget-smoke.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "groq-sdk": "^0.9.1",
    "ipaddr.js": "^2.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
